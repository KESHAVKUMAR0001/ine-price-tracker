PORT=5000
FRONTEND_URL=http://localhost:5173

# Supabase Credentials (found in your Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Scraper mode: headless (default for servers) or headed (for visual local testing)
SCRAPER_MODE=headless

# Secret key required in Authorization: Bearer <CRON_SECRET> for POST /api/cron/scrape-all
CRON_SECRET=your-random-cron-secret-key
